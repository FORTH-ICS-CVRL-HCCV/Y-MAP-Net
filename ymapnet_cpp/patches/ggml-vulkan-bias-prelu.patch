+// v = x + bias; pos = relu(v); y = pos + (v - pos) * alpha   (PReLU with per-channel bias/alpha on ne0)
+bool ggml_vk_can_fuse_bias_prelu(ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    if (node_idx + (int)bias_prelu_pattern.size() > cgraph->n_nodes) {
+        return false;
+    }
+    for (size_t j = 0; j < bias_prelu_pattern.size(); ++j) {
+        const ggml_tensor * n = cgraph->nodes[node_idx + j];
+        if (n->op != bias_prelu_pattern.begin()[j] || (n->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return false;
+        }
+    }
+    const ggml_tensor * add0 = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * relu = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * sub  = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * mul  = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * out  = cgraph->nodes[node_idx + 4];
+
+    // wiring
+    if (ggml_get_unary_op(relu) != GGML_UNARY_OP_RELU || relu->src[0] != add0) return false;
+    if (sub->src[0] != add0 || sub->src[1] != relu) return false;
+    if (mul->src[0] != sub && mul->src[1] != sub) return false;
+    if (!((out->src[0] == relu && out->src[1] == mul) || (out->src[0] == mul && out->src[1] == relu))) return false;
+
+    // intermediates are only used inside the pattern
+    const int32_t uses[4] = { 2, 2, 1, 1 };
+    for (int j = 0; j < 4; ++j) {
+        if (!ggml_node_has_n_uses(cgraph, node_idx + j, uses[j])) return false;
+    }
+
+    const ggml_tensor * x     = ggml_are_same_shape(add0, add0->src[0]) ? add0->src[0] : add0->src[1];
+    const ggml_tensor * bias  = (x == add0->src[0]) ? add0->src[1] : add0->src[0];
+    const ggml_tensor * alpha = (mul->src[0] == sub) ? mul->src[1] : mul->src[0];
+    const int64_t C = out->ne[0];
+
+    for (const ggml_tensor * t : { x, bias, alpha, add0, relu, sub, mul, out }) {
+        if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t)) return false;
+    }
+    if (!ggml_are_same_shape(x, out)) return false;
+    if (bias->ne[0] != C || ggml_nelements(bias) != C) return false;
+    if (alpha->ne[0] != C || ggml_nelements(alpha) != C) return false;
+    if (ggml_nelements(out) > UINT32_MAX) return false;
+    for (const ggml_tensor * t : { x, bias, alpha, out }) {
+        if (get_misalign_bytes(ctx, t) != 0) return false;
+    }
+    return true;
+}
