+void ggml_vk_bias_prelu_dispatch_fused(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * add0 = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * mul  = cgraph->nodes[node_idx + 3];
+    ggml_tensor *       out  = cgraph->nodes[node_idx + 4];
+
+    const ggml_tensor * x     = ggml_are_same_shape(add0, add0->src[0]) ? add0->src[0] : add0->src[1];
+    const ggml_tensor * bias  = (x == add0->src[0]) ? add0->src[1] : add0->src[0];
+    const ggml_tensor * alpha = (mul->src[0] == cgraph->nodes[node_idx + 2]) ? mul->src[1] : mul->src[0];
+
+    vk_pipeline pipeline = ctx->device->pipeline_bias_prelu_f32;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_op_bias_prelu_push_constants pc{};
+    pc.ne  = static_cast<uint32_t>(ggml_nelements(out));
+    pc.ne0 = static_cast<uint32_t>(out->ne[0]);
+
+    std::array<uint32_t, 3> elements;
+    if (pc.ne > 262144) {
+        elements = { 512, 512, CEIL_DIV(pc.ne, 262144) };
+    } else if (pc.ne > 512) {
+        elements = { 512, CEIL_DIV(pc.ne, 512), 1 };
+    } else {
+        elements = { pc.ne, 1, 1 };
+    }
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
+        { ggml_vk_tensor_subbuffer(ctx, x), ggml_vk_tensor_subbuffer(ctx, bias),
+          ggml_vk_tensor_subbuffer(ctx, alpha), ggml_vk_tensor_subbuffer(ctx, out) }, pc, elements);
+}
