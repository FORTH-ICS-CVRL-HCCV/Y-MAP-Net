diff --git a/src/ggml-vulkan/vulkan-shaders/bias_prelu.comp b/src/ggml-vulkan/vulkan-shaders/bias_prelu.comp
new file mode 100644
index 0000000..c6ac92c
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/bias_prelu.comp
@@ -0,0 +1,37 @@
+#version 450
+
+// Fused per-channel bias + PReLU, replacing the graph
+//   v = x + bias;  pos = relu(v);  y = pos + (v - pos) * alpha
+// i.e. y = v > 0 ? v : alpha * v, with bias/alpha indexed by the ne0 (channel) coordinate.
+//   data_x [ne]   contiguous input
+//   data_b [ne0]  per channel bias
+//   data_a [ne0]  per channel slope
+//   data_d [ne]   contiguous output
+layout (binding = 0) readonly  buffer X {float data_x[];};
+layout (binding = 1) readonly  buffer B {float data_b[];};
+layout (binding = 2) readonly  buffer A {float data_a[];};
+layout (binding = 3) writeonly buffer D {float data_d[];};
+
+const uint num_threads = 256;
+
+layout(local_size_x = num_threads, local_size_y = 1, local_size_z = 1) in;
+
+layout (push_constant) uniform parameter {
+    uint ne;
+    uint ne0;
+} p;
+
+void main() {
+    // num_threads * num_iter must equal 512, to match the wg_denoms and the 512x512xN dispatch
+    const uint num_iter = 2;
+    uint idx = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;
+
+    for (uint i = 0; i < num_iter; ++i) {
+        if (idx < p.ne) {
+            const uint c = idx % p.ne0;
+            const float v = data_x[idx] + data_b[c];
+            data_d[idx] = v > 0.0 ? v : v * data_a[c];
+        }
+        idx += num_threads;
+    }
+}
